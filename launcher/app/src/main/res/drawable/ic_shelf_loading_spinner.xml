<?xml version="1.0" encoding="utf-8"?>
<!-- Arc ring: rotates slowly under the loading sheet. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size
                android:width="28dp"
                android:height="28dp" />
            <stroke
                android:width="3dp"
                android:color="#33FFFFFF" />
        </shape>
    </item>
    <item>
        <rotate
            android:fromDegrees="-90"
            android:toDegrees="-90"
            android:pivotX="50%"
            android:pivotY="50%">
            <shape android:shape="oval">
                <size
                    android:width="28dp"
                    android:height="28dp" />
                <stroke
                    android:width="3dp"
                    android:color="#FFFFFFFF"
                    android:dashWidth="14dp"
                    android:dashGap="60dp" />
            </shape>
        </rotate>
    </item>
</layer-list>
